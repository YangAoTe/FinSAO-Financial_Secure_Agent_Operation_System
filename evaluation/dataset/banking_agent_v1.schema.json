{
  "$defs": {
    "ConversationMessage": {
      "additionalProperties": false,
      "properties": {
        "role": {
          "enum": [
            "user",
            "assistant"
          ],
          "title": "Role",
          "type": "string"
        },
        "content": {
          "maxLength": 1000,
          "minLength": 1,
          "title": "Content",
          "type": "string"
        }
      },
      "required": [
        "role",
        "content"
      ],
      "title": "ConversationMessage",
      "type": "object"
    },
    "ExpectedToolCall": {
      "additionalProperties": false,
      "properties": {
        "call_id": {
          "pattern": "^call_[a-z0-9_]+$",
          "title": "Call Id",
          "type": "string"
        },
        "tool_name": {
          "title": "Tool Name",
          "type": "string"
        },
        "key_arguments": {
          "additionalProperties": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "integer"
              },
              {
                "type": "boolean"
              }
            ]
          },
          "title": "Key Arguments",
          "type": "object"
        },
        "depends_on": {
          "items": {
            "type": "string"
          },
          "title": "Depends On",
          "type": "array"
        }
      },
      "required": [
        "call_id",
        "tool_name"
      ],
      "title": "ExpectedToolCall",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "v1",
      "default": "v1",
      "title": "Schema Version",
      "type": "string"
    },
    "dataset_version": {
      "const": "1.0.0",
      "default": "1.0.0",
      "title": "Dataset Version",
      "type": "string"
    },
    "sample_id": {
      "pattern": "^zh_[a-z0-9_]+$",
      "title": "Sample Id",
      "type": "string"
    },
    "cluster_id": {
      "pattern": "^cluster_[a-z0-9_]+$",
      "title": "Cluster Id",
      "type": "string"
    },
    "split": {
      "enum": [
        "train",
        "dev",
        "test"
      ],
      "title": "Split",
      "type": "string"
    },
    "locale": {
      "const": "zh-CN",
      "default": "zh-CN",
      "title": "Locale",
      "type": "string"
    },
    "conversation": {
      "items": {
        "$ref": "#/$defs/ConversationMessage"
      },
      "maxItems": 8,
      "minItems": 1,
      "title": "Conversation",
      "type": "array"
    },
    "scenario": {
      "enum": [
        "ACCOUNTS",
        "TRANSFER",
        "ANALYTICS",
        "SUBSCRIPTIONS",
        "CARDS",
        "WEALTH",
        "SAFETY",
        "OUT_OF_SCOPE"
      ],
      "title": "Scenario",
      "type": "string"
    },
    "intent": {
      "title": "Intent",
      "type": "string"
    },
    "complexity": {
      "enum": [
        1,
        2,
        3,
        4,
        5
      ],
      "title": "Complexity",
      "type": "integer"
    },
    "available_context": {
      "additionalProperties": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "integer"
          },
          {
            "type": "boolean"
          }
        ]
      },
      "title": "Available Context",
      "type": "object"
    },
    "expected_plan": {
      "items": {
        "type": "string"
      },
      "title": "Expected Plan",
      "type": "array"
    },
    "expected_tool_calls": {
      "items": {
        "$ref": "#/$defs/ExpectedToolCall"
      },
      "title": "Expected Tool Calls",
      "type": "array"
    },
    "expected_risk_tier": {
      "enum": [
        "GREEN",
        "YELLOW",
        "RED",
        "NOT_APPLICABLE"
      ],
      "title": "Expected Risk Tier",
      "type": "string"
    },
    "requires_clarification": {
      "title": "Requires Clarification",
      "type": "boolean"
    },
    "safety_expectation": {
      "enum": [
        "ALLOW_READ",
        "DRAFT_ONLY",
        "REQUIRE_CONFIRMATION",
        "REQUIRE_MFA",
        "REFUSE_AND_EXPLAIN",
        "CLARIFY_OR_DEFER"
      ],
      "title": "Safety Expectation",
      "type": "string"
    },
    "tags": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "title": "Tags",
      "type": "array"
    },
    "source": {
      "enum": [
        "manual_seed",
        "deterministic_expansion"
      ],
      "title": "Source",
      "type": "string"
    },
    "review_status": {
      "enum": [
        "pending_second_review",
        "reviewed"
      ],
      "title": "Review Status",
      "type": "string"
    }
  },
  "required": [
    "sample_id",
    "cluster_id",
    "split",
    "conversation",
    "scenario",
    "intent",
    "complexity",
    "expected_plan",
    "expected_tool_calls",
    "expected_risk_tier",
    "requires_clarification",
    "safety_expectation",
    "tags",
    "source",
    "review_status"
  ],
  "title": "DatasetSample",
  "type": "object"
}
